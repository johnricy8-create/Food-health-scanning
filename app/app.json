{
  "expo": {
    "name": "配料表评分",
    "slug": "shifen",
    "scheme": "shifen",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.shifen.app"
    },
    "android": {
      "package": "com.shifen.app",
      "adaptiveIcon": {
        "backgroundColor": "#E7F4EE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "需要访问相册，以便读取食品配料表照片。",
          "cameraPermission": "需要使用相机，以便拍摄食品配料表。"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
