# 复制成 .env 后填入。这个文件永远不会进 git，也永远不会进 App 包。

# 供应商：zhipu（智谱 GLM，默认）或 gemini
AI_PROVIDER=zhipu

# 智谱 AI —— 文本模型负责结构化，视觉模型负责把照片抄成文字
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-4.7-flash
AI_VISION_MODEL=glm-4.6v

# 是否额外让模型写一句转述。默认关闭：
# 界面用的是规则生成的「为什么是这个分数」，开了只会多一次调用、慢十几秒。
AI_NARRATIVE=0

# 如果切回 Gemini，填这一行并把 AI_PROVIDER 改成 gemini
GEMINI_API_KEY=

# 中转服务端口
PORT=8787

# 每 IP 每小时请求上限（上线前请换成 Redis / Cloudflare 方案）
RATE_LIMIT_PER_HOUR=60
